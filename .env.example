# Runtime
PROJECT_NAME=wildfire-intelligence-platform
ENVIRONMENT=development
LOG_LEVEL=INFO
API_VERSION=0.1.0
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://api:8000
INTERNAL_API_TOKEN=change-me-local-internal-token

# PostgreSQL/PostGIS
POSTGRES_DB=wildfire
POSTGRES_USER=wildfire
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://wildfire:change-me-local@postgres:5432/wildfire

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
TASK_ALWAYS_EAGER=false

# MinIO/S3
MINIO_ROOT_USER=wildfire-local
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_RAW=raw-ingestion
S3_ACCESS_KEY_ID=wildfire-local
S3_SECRET_ACCESS_KEY=change-me-local-minio
S3_REGION=eu-west-1

# NASA FIRMS: request a key at https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_AREA_SPAIN=-10.0,35.5,4.5,44.5
FIRMS_DAY_RANGE=1
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# EFFIS
EFFIS_WFS_URL=https://maps.effis.emergency.copernicus.eu/effis
EFFIS_TYPE_NAME=ms:modis.ba.poly
EFFIS_AREA_BBOX=-10.0,35.5,4.5,44.5

# AEMET: request a key at https://opendata.aemet.es/
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata
AEMET_FORECAST_MUNICIPALITIES=28079
AEMET_FORECAST_LOCATIONS_JSON={"28079":{"name":"Madrid","latitude":40.4168,"longitude":-3.7038}}
AEMET_ALERTS_FEED_URL=https://www.aemet.es/documentos_d/eltiempo/prediccion/avisos/rss/CAP_AFAE_wah_RSS.xml

# IGN/CNIG and OSM
IGN_WFS_BASE_URL=https://api-features.idee.es
IGN_TRANSPORT_TYPENAME=roadlink
IGN_AREA_BBOX=-10.0,35.5,4.5,44.5
IGN_FEATURE_LIMIT=1000
IGN_MAX_FEATURES=250000
IGN_MAX_PAGES_PER_TILE=3
IGN_TILE_SIZE_DEGREES=1.0
IGN_TARGET_DATEX_RESTRICTIONS=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_AREA_BBOX=-3.75,40.38,-3.65,40.45
OSM_FEATURE_LIMIT=100
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# Traffic and Civil Protection
DATEX_FEED_URLS=https://nap.dgt.es/dataset/77be854a-6911-47dc-ba4c-b13067a50552/resource/1d36ea74-593d-4e45-acfa-fb8db5a460bc/download/datex2_v37.xml,https://infocar.dgt.es/datex2/sct/SituationPublication/all/content.xml,https://infocar.dgt.es/datex2/dt-gv/SituationPublication/all/content.xml
ETRAFFIC_BASE_URL=https://etraffic.dgt.es/etrafficWEB/api
ETRAFFIC_PUBLIC_URL=https://etraffic.dgt.es/etrafficWEB/
PROTECCIO_CIVIL_PLANS_URL=https://analisi.transparenciacatalunya.cat/api/v3/views/wj9c-j6vf/query.json?accessType=DOWNLOAD

# Emergency OSINT. Nitter works without credentials; X is optional.
X_BEARER_TOKEN=
OSINT_NITTER_ENABLED=true
OSINT_NITTER_BASE_URL=https://nitter.net
OSINT_X_OFFICIAL_ACCOUNTS=proteccioncivil,interiorgob,emergenciescat,112cv,112_sosdeiak
OSINT_IGN_MUNICIPALITIES_URL=https://services1.arcgis.com/nCKYwcSONQTkPA4K/arcgis/rest/services/muni/FeatureServer/0/query
